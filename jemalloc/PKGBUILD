pkgname="carbonio-jemalloc"
pkgver="5.4.0" # renovate: datasource=github-releases depName=jemalloc/jemalloc
pkgrel="1"
pkgdesc="General-purpose scalable concurrent malloc implementation"
arch=('aarch64' 'x86_64')
license=('LicenseRef-BSD')
section="mail"
priority="extra"
maintainer="Zextras <packages@zextras.com>"
url="https://github.com/zextras"
depends__apt=(
  "libgcc-s1"
  "libc6"
)
source=("https://github.com/jemalloc/jemalloc/releases/download/${pkgver}/jemalloc-${pkgver}.tar.bz2")
sha256sums=('200776fac271093e7c2f21edd6d62657ecd2be578d9328633f2a86bfa6ef4f1d')

build() {
  cd "${srcdir}/jemalloc-${pkgver}"

  _host_flag=""
  _build_flag=""
  if [ -n "${CROSS_COMPILE}" ]; then
    _host_flag="--host=${CROSS_COMPILE_HOST}"
    _build_flag="--build=$(gcc -dumpmachine)"
    # sched_getcpu requires _GNU_SOURCE; cross-compiler sysroot needs it explicit
    export CFLAGS="${CFLAGS} -D_GNU_SOURCE"
    export CPPFLAGS="${CPPFLAGS} -D_GNU_SOURCE"
  fi

  ./configure \
    --enable-autogen \
    --prefix=/opt/zextras/common \
    ${_host_flag} ${_build_flag}
  _jobs=$(($(nproc) / 2))
  [ "$_jobs" -lt 1 ] && _jobs=1
  make -j"$_jobs"
}

package() {
  cd "${srcdir}/jemalloc-${pkgver}"

  make DESTDIR="${pkgdir}" install
  chmod 644 "${pkgdir}/opt/zextras/common/lib/libjemalloc_pic.a"
}
