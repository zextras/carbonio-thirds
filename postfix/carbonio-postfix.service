[Unit]
Description=Carbonio Postfix Daemon
After=carbonio-configd.service carbonio-milter.service carbonio-saslauthd.service
Wants=carbonio-configd.service carbonio-milter.service carbonio-saslauthd.service carbonio-mta-sidecar.service
PartOf=carbonio-mta.target

[Service]
User=zextras
Type=forking
PIDFile=/opt/zextras/data/postfix/spool/pid/master.pid
NotifyAccess=all
CapabilityBoundingSet=~ CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SYS_BOOT CAP_SYS_MODULE
# configd renders main.cf, then the leaves render the ldap-*.cf tables,
# rebuild aliases and drive postfix through sudo.
ExecStartPre=/bin/sh -c 'echo REWRITE mta | netcat -w 120 localhost 7171'
ExecStart=/opt/zextras/bin/configd service start-systemd mta
ExecStop=/opt/zextras/bin/configd service stop-systemd mta
ExecReload=/opt/zextras/bin/configd service reload-systemd mta
Restart=on-failure
RestartSec=3s
LimitNOFILE=524288

# Hardening: mount-namespace options only. The unit runs as zextras and
# configd drives postfix through sudo; on systemd 252 (RHEL 9) any
# seccomp-based option (RestrictAddressFamilies, RestrictNamespaces,
# RestrictRealtime, LockPersonality, ProtectKernel*, ProtectHostname,
# ProtectClock, SystemCallFilter, ...) implies NoNewPrivileges for a
# non-root unit, and sudo then refuses to run (CO-4780, as CO-4222 for
# carbonio-configd.service). Do not add them back.
ProtectHome=yes
ProtectControlGroups=yes

[Install]
WantedBy=carbonio-mta.target
