pkgname="carbonio-libmilter"
pkgver="8.18.2" # renovate: datasource=repology depName=arch/libmilter
pkgrel="1"
pkgdesc="Implementation of the sendmail Mail Filter API"
arch=('aarch64' 'x86_64')
maintainer="Zextras <packages@zextras.com>"
url="https://github.com/zextras"
license=('Sendmail-8.23')
section="libs"
priority="important"
source=(
  "https://ftp.sendmail.org/sendmail.${pkgver}.tar.gz"
  "site.config.m4"
)
sha256sums=('1a085faa8ace52cffde2f5e9bc611bdb5f81481caaabf46f0437b719ca089d2f'
  '9ea8ce8a8fc6179da65d0e9b7b6d7016d9a3f38070db4acce56d17a8d78ed3ad')

build() {
  cd "${srcdir}/sendmail-${pkgver}"

  cp "${srcdir}/site.config.m4" devtools/Site
  export LDFLAGS="-Wl,-rpath,/opt/zextras/common/lib"

  # Sendmail Build reads confCC from site.config.m4, not $CC.
  if [ -n "${CROSS_COMPILE}" ]; then
    printf "define(\`confCC', \`%sgcc')\ndefine(\`confAR', \`%sar')\ndefine(\`confRANLIB', \`%sranlib')\ndefine(\`confLIBSEARCHPATH', \`/opt/zextras/common/lib')\n" \
      "${CROSS_COMPILE}" "${CROSS_COMPILE}" "${CROSS_COMPILE}" >>devtools/Site/site.config.m4
    export AR="${CROSS_COMPILE}ar"
    export RANLIB="${CROSS_COMPILE}ranlib"
  fi

  cd libmilter
  ./Build
}

package() {
  cd "${srcdir}/sendmail-${pkgver}"

  cd libmilter
  install -d "${pkgdir}/opt/zextras/common/lib"
  install -d "${pkgdir}/opt/zextras/common/include"
  if [ -n "${CROSS_COMPILE}" ]; then
    export CC="${CROSS_COMPILE}gcc"
    export AR="${CROSS_COMPILE}ar"
    export RANLIB="${CROSS_COMPILE}ranlib"
  fi
  ./Build DESTDIR="${pkgdir}" install
}
