pkgname="carbonio-libxml2"
pkgver="2.15.4" # renovate: datasource=github-tags depName=GNOME/libxml2
pkgrel="1"
pkgdesc="XML parsing library, version 2"
arch=('aarch64' 'x86_64')
maintainer="Zextras <packages@zextras.com>"
url="https://github.com/zextras"
license=('MIT')
depends__apt=(
  "carbonio-icu"
  "zlib1g"
)
depends__yum=(
  "carbonio-icu"
  "zlib"
)
makedepends__apt=(
  "autoconf"
  "automake"
  "libtool"
  "pkg-config"
  "zlib1g-dev"
)
makedepends__yum=(
  "autoconf"
  "automake"
  "libtool"
  "zlib-devel"
)
section="libs"
priority="important"
options=('!libtool')
source=(
  "https://download.gnome.org/sources/libxml2/${pkgver%.*}/libxml2-${pkgver}.tar.xz"
)
sha256sums=('98087fd181d9070724f3fbc65c7377db03038eb92bd882374daff44940138821')

build() {
  cd "${srcdir}/libxml2-${pkgver}"
  export LDFLAGS="-Wl,-rpath,/opt/zextras/common/lib"
  export CFLAGS="-ffile-prefix-map=${srcdir}=. -I/opt/zextras/common/include"
  export PKG_CONFIG_PATH="/opt/zextras/common/lib/pkgconfig:/opt/zextras/common/lib64/pkgconfig"

  # Release tarball ships a generated configure; autoreconf would need
  # automake >= 1.16.3, which el8 lacks.

  _host_flag=""
  _build_flag=""
  if [ -n "${CROSS_COMPILE}" ]; then
    _host_flag="--host=${CROSS_COMPILE_HOST}"
    _build_flag="--build=$(gcc -dumpmachine)"

    # PKG_CONFIG_LIBDIR replaces the default search path — keeps host ICU out.
    export PKG_CONFIG_LIBDIR="/opt/zextras/common/lib/pkgconfig"

    # Also add the arm64 system pkgconfig dir so cross-installed libs are found.
    _cross_pkgconfig="/usr/${CROSS_COMPILE_HOST}/lib/pkgconfig"
    if [ -d "${_cross_pkgconfig}" ]; then
      export PKG_CONFIG_LIBDIR="${PKG_CONFIG_LIBDIR}:${_cross_pkgconfig}"
    fi
  fi

  ./configure \
    --prefix=/opt/zextras/common \
    --enable-shared=yes \
    --enable-static=no \
    --without-python \
    --without-iconv \
    --with-icu \
    ${_host_flag} ${_build_flag}
  _jobs=$(($(nproc) / 2))
  [ "$_jobs" -lt 1 ] && _jobs=1
  make -j"$_jobs"
}

package() {
  cd "${srcdir}/libxml2-${pkgver}"
  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}"/opt/zextras/common/bin/xml2-config
  rm -rf "${pkgdir}"/opt/zextras/common/share/man
  rm -rf "${pkgdir}"/opt/zextras/common/share/gtk-doc
}
