[Unit]
Description=Carbonio OpenLDAP Daemon
After=network.target network-online.target nss-lookup.target
Wants=network-online.target
PartOf=carbonio-directory-server.target

[Service]
User=zextras
Type=notify
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Without bind_url slapd would listen on ldapi:/// only: fail, so that
# Restart=on-failure retries, instead of running with no TCP listener.
ExecStartPre=/opt/zextras/bin/configd exec -- /bin/sh -c '[ -n "$bind_url" ] || { echo "bind_url is empty (neither ldap_bind_url nor ldap_url is set in localconfig): not starting slapd without a TCP listener" >&2; exit 1; }'
ExecStart=/opt/zextras/bin/configd exec -- /opt/zextras/common/libexec/slapd -d 0 -l LOCAL0 -h '$${bind_url} ldapi:///' -F /opt/zextras/data/ldap/config
Restart=on-failure
RestartSec=3s
LimitNOFILE=524288

# Hardening
PrivateTmp=yes
#ProtectSystem=strict
#ReadWritePaths=/opt/zextras/data /run/carbonio
ProtectSystem=yes
NoNewPrivileges=yes
PrivateDevices=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectHostname=yes
ProtectClock=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=carbonio-directory-server.target
